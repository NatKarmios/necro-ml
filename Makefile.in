
##########################################################################################
#                       CONFIGURE                                                        #
##########################################################################################

OPAM = @OPAM@
OPAMBINDIR = @OPAMBINDIR@
OPAMLIBDIR = @OPAMLIBDIR@
NECROLIB = @NECROLIB@

##########################################################################################
#                       VARIABLES                                                        #
##########################################################################################

SHELL=bash
red=`tput setaf 1``tput setab 7`
reset=`tput sgr0`
TESTS_RULES = $(shell ls necro-test/*.sk)
TESTS = $(addprefix test/,$(shell ls test))

NAME := necro-ml
# WARNING : GIT TAG is prefixed with "v"
VERSION := 2.5.2
TGZ := $(NAME)-v$(VERSION).tar.gz
MD5TXT := $(TGZ).md5sum.txt

# GIT VARIABLES
GITLAB := gitlab.inria.fr
GITPROJECT := skeletons
GIT_REPO := git@$(GITLAB):$(GITPROJECT)/$(NAME).git
GIT_RELEASE := https://$(GITLAB)/$(GITPROJECT)/$(NAME)/-/archive/v$(VERSION)/$(TGZ)

# OPAM VARIABLES
OPAM_REPO_GIT := ../opam-repository
OPAM_NAME := $(subst -,,$(NAME))

##########################################################################################
#                       TARGET                                                           #
##########################################################################################

all: necroml necromonads.cma

necromonads.cma:
	ocamlc -c necromonads.ml
	ocamlc -a necromonads.cmo -o necromonads.cma

# This target manage standalone local install but path to necrolib is asked
necroml: mlast.mli mlprinter.ml generator.ml necroml.ml
ifeq ($(NECROLIB),no)
	@read -p "Please fill path to NECROLIB:" g;\
	ocamlc -I $$g/main necro.cma mlast.mli mlprinter.ml generator.ml necroml.ml -o necroml
else
	@ocamlfind ocamlc -package necro -linkpkg necro.cma mlast.mli mlprinter.ml generator.ml necroml.ml -o necroml
endif

clean:
	@rm -f *.cm[ioa] necroml test/*.cm[io] *.native  $(TGZ) $(MD5TXT) config.status config.log configure
	@rm -f test/{arith{,_list},brainfuck,concurrent,implicits,lambda,lists{,_list},miniml,nat,options,pcf,while{,_amb}}.ml
	@rm -rf autom4te.cache
	@make clean -C test/SudoKu > /dev/null

test: necroml Makefile $(TESTS)
	@echo "Testing necroml on features.sk"
	@set -o pipefail ;
	@./necroml necro-test/features.sk -o test/features.ml ;
	@ocamlc -c test/features.ml || echo "$(red)Error in file features.sk testing necroml.$(reset)"

	@echo "Testing necroml on arithmetic.sk"
	@set -o pipefail
	@./necroml necro-test/arithmetic.sk -o test/arith.ml
	@ocamlc -I test test/monads.ml test/arith.ml test/test_interpreter_arith.ml -o test_interpreter_arith.native
	@./test_interpreter_arith.native || echo "$(red)Error in file arithmetic.sk testing necroml.$(reset)"

	@echo "Testing necroml on brainfuck.sk"
	@set -o pipefail
	@./necroml necro-test/brainfuck.sk -o test/brainfuck.ml
	@ocamlc -I test test/monads.ml test/brainfuck.ml test/test_interpreter_bf.ml -o test_interpreter_bf.native
	@./test_interpreter_bf.native || echo "$(red)Error in file brainfuck.sk testing necroml.$(reset)"

	@echo "Testing necroml on buggy_branch.sk"
	@set -o pipefail
	@./necroml necro-test/buggy_branch.sk -o test/buggy_branch.ml
	@ocamlc -I test test/monads.ml test/buggy_branch.ml test/test_interpreter_buggy_branch.ml -o test_interpreter_buggy_branch.native
	@./test_interpreter_buggy_branch.native || echo "$(red)Error in file buggy_branch.sk testing necroml.$(reset)"

	@echo "Testing necroml on implicits.sk"
	@set -o pipefail
	@./necroml necro-test/implicits.sk -o test/implicits.ml
	@ocamlc -I test test/monads.ml test/implicits.ml test/test_interpreter_implicits.ml -o test_interpreter_implicits.native
	@./test_interpreter_implicits.native || echo "$(red)Error in file implicits.sk testing necroml.$(reset)"

	@echo "Testing necroml on lambda.sk"
	@set -o pipefail
	@./necroml necro-test/lambda.sk -o test/lambda.ml
	@ocamlc -I test test/monads.ml test/lambda.ml test/test_interpreter_lambda.ml -o test_interpreter_lambda.native
	@./test_interpreter_lambda.native || echo "$(red)Error in file lambda.sk testing necroml.$(reset)"

	@echo "Testing necroml on lists.sk"
	@set -o pipefail
	@./necroml necro-test/lists.sk -o test/lists.ml
	@ocamlc -I test test/monads.ml test/lists.ml test/test_interpreter_lists.ml -o test_interpreter_lists.native
	@./test_interpreter_lists.native || echo "$(red)Error in file lists.sk testing necroml.$(reset)"

	@echo "Testing necroml on miniml.sk"
	@set -o pipefail
	@./necroml necro-test/miniml.sk -o test/miniml.ml
	@ocamlc -I test test/monads.ml test/miniml.ml test/test_interpreter_miniml.ml -o test_interpreter_miniml.native
	@./test_interpreter_miniml.native || echo "$(red)Error in file miniml.sk testing necroml.$(reset)"

	@echo "Testing necroml on nat.sk"
	@set -o pipefail
	@./necroml necro-test/nat.sk -o test/nat.ml
	@ocamlc -I test test/monads.ml test/nat.ml test/test_interpreter_nat.ml -o test_interpreter_nat.native
	@./test_interpreter_nat.native || echo "$(red)Error in file nat.sk testing necroml.$(reset)"

	@echo "Testing necroml on options_monad.sk"
	@set -o pipefail
	@./necroml necro-test/options_monad.sk -o test/options.ml
	@ocamlc -I test test/monads.ml test/options.ml test/test_interpreter_options.ml -o test_interpreter_options.native
	@./test_interpreter_options.native || echo "$(red)Error in file options_monad.sk testing necroml.$(reset)"

	@echo "Testing necroml on pcf.sk"
	@set -o pipefail
	@./necroml necro-test/pcf.sk -o test/pcf.ml
	@ocamlc -I test test/monads.ml test/pcf.ml test/test_interpreter_pcf.ml -o test_interpreter_pcf.native
	@./test_interpreter_pcf.native || echo "$(red)Error in file pcf.sk testing necroml.$(reset)"

	@echo "Testing necroml on while_monad.sk"
	@set -o pipefail
	@./necroml necro-test/while_monad.sk -o test/while.ml
	@ocamlc -I test test/monads.ml test/while.ml test/test_interpreter_while.ml -o test_interpreter_while.native
	@./test_interpreter_while.native || echo "$(red)Error in file while_monad.sk testing necroml.$(reset)"

	@echo "Testing necroml on while_amb.sk"
	@set -o pipefail
	@./necroml necro-test/while_amb.sk -o test/while_amb.ml
	@ocamlc -I test test/monads.ml test/while_amb.ml test/test_interpreter_while_amb.ml -o test_interpreter_while_amb.native
	@./test_interpreter_while_amb.native || echo "$(red)Error in file while_amb.sk testing necroml --collect.$(reset)"

	@echo "Testing necroml on concurrent.sk"
	@set -o pipefail
	@./necroml necro-test/concurrent.sk -o test/concurrent.ml
	@ocamlc -I test test/monads.ml test/concurrent.ml test/test_interpreter_concurrent.ml -o test_interpreter_concurrent.native
	@./test_interpreter_concurrent.native || echo "$(red)Error in file concurrent.sk testing necroml --collect.$(reset)"

	@echo "Testing SudoKu"
	@make test -C test/SudoKu > /dev/null

opam_install_necroml : necroml necromonads.cma
ifeq ($(OPAM),opam)
  ifneq ($(OPAMBINDIR),)
    ifneq ($(NECROLIB), no)
	@cp necroml $(OPAMBINDIR)/necroml
	@mkdir $(OPAMLIBDIR)/necromonads
	@echo 'archive(byte) = "necromonads.cma"' > $(OPAMLIBDIR)/necromonads/META
	@cp necromonads.cma necromonads.cmi $(OPAMLIBDIR)/necromonads
    endif
  endif
endif

opam_remove_necroml :
	@rm -f  $(OPAMBINDIR)/necroml
	@rm -rf $(OPAMLIBDIR)/necromonads

# Download tarball from gitlab tag
# Get its hashcode and store it in plain text file
$(TGZ):
	@rm -f $(TGZ) $(MD5TXT)
	@wget -q $(GIT_RELEASE)

#Create checkum txt file
$(MD5TXT): $(TGZ)
	@md5sum $(TGZ) > $(MD5TXT)

# Update tarball hashcode in of opam file.
# Copy opam file in OPAM repository.
# INFO :
#  - Copying file from a local repository to another could be discuss, any
#    better automated mechanism is welcome, because here the workflow imply
#    a new manual commit/push in OPAM repository for each new tarball/release.
#  - md5sum of opam file in the tgz archive won't ever be the same
#    as the one in opam-repository. This should not be an issue since
#    the md5sum checked is the one in OPAM repository not the one in the archive.
opam_file_update : $(MD5TXT)
	@sed -i -r 's|^(\schecksum: "md5\s*=\s*).*"|\1'$$(cat *.txt | cut -d" " -f 1)'"|' opam
	@mkdir -p $(OPAM_REPO_GIT)/packages/$(OPAM_NAME)/$(OPAM_NAME).$(VERSION)/ &&\
		cp opam $(OPAM_REPO_GIT)/packages/$(OPAM_NAME)/$(OPAM_NAME).$(VERSION)/

# Delete and create again tag for opam deployment.
# Once previous version of tag is deleted locally and remotly it is
# created again and pushed
git_tag:
	git tag -a v$(VERSION) -fm 'OPAM necroml package for deployment'
	git push --follow-tags

# Change version number everywhere where it's specified, and update Makefile
new_version:
	@rm -f $(TGZ) $(MD5TXT)
	@read -p "Please enter new version (current is $(VERSION)): " g;\
	sed -i -r "s/^version: \"$(VERSION)\"/version: \"$$g\"/" ./opam;\
	sed -i -r "s#archive/v$(VERSION)#archive/v$$g#" ./opam;\
	sed -i -r "s#v$(VERSION).tar.gz#v$$g.tar.gz#" ./opam;\
	sed -i -r "s/^VERSION := $(VERSION)/VERSION := $$g/" ./Makefile.in
	autoconf ; ./configure

.PHONY: all test clean  $(TGZ) $(MD5TXT) opam_install_necroml opam_remove_necroml opam_file_update
