term sublist<a>: (m: nat) → (n: nat) → (l: list<a>) → list<a> =
	(* Extract n elements of the list, beginning at position m *)
	branch
		let Z = m in
		let Z = n in
		Nil<a>
	or
		let Z = m in
		let S n' = n in
		let Cons (x, q) = l in
		let aux = sublist<a> Z n' q in
		Cons<a> (x, aux)
	or
		let S m' = m in
		let Cons (_, q) = l in
		sublist<a> m' n q
	end

term list_map<a,b>: (f: a → b) → (l: list<a>) → list<b> =
	branch
		let Nil = l in Nil<b>
	or
		let Cons (x, q) = l in
		let y = f x in
		let r = list_map<a, b> f q in
		Cons<b> (y, r)
	end

term list_append<a>: (l:list<a>) → (m:list<a>) → list<a> =
	branch
		let Nil = l in m
	or
		let Cons (x, q) = l in
		let aux = list_append<a> q m in
		Cons<a> (x, aux)
	end

term list_flatten<a>: (l:list<list<a>>) → list<a> =
	branch
		let Nil = l in Nil<a>
	or
		let Cons (x, q) = l in
		let aux = list_flatten<a> q in
		list_append<a> x aux
	end

term list_switch<a>: (n:nat) → (a:a) → (l:list<a>) → (a, list<a>) =
	let Cons (x, q) = l in
	branch
		let Z = n in (x, Cons<a> (a, q))
	or
		let S m = n in
		let (gotten, new_list) = list_switch<a> m a q in
		(gotten, Cons<a> (x, new_list))
	end

term list_nth<a>: (n:nat) → (l:list<a>) → a =
	let Cons (x, q) = l in
	branch
		let Z = n in x
	or
		let S m = n in
		list_nth<a> m q
	end

type boolean =
| True | False
type list<a> =
| Nil | Cons (a, list<a>)

type nat =
| Z | S nat

term add: (a:nat) → (b:nat) → nat =
	branch
		let Z = a in b
	or
		let S a' = a in
		let aux = add a' b in
		S aux
	end

term mul: (a:nat) → (b:nat) → nat =
	branch
		let Z = a in Z
	or
		let S a' = a in
		let aux = mul a' b in
		add aux b
	end

type line := list<nat>
type grid := (nat,list<list<nat>>)

term eq: (v1:nat) → (v2:nat) → boolean =
	branch
		let (Z, Z) = (v1, v2) in True
	or
		let (Z, S _) = (v1, v2) in False
	or
		let (S _, Z) = (v1, v2) in False
	or
		let (S a, S b) = (v1, v2) in eq a b
	end
		
term neg: (b:boolean) → boolean =
	branch
		let True = b in False
	or
		let False = b in True
	end

term neq: (v1:nat) → (v2:nat) → boolean =
	let eq = eq v1 v2 in
	neg eq

term mem: (v:nat) → (l:list<nat>) → boolean =
	branch
		let Nil = l in False
	or
		let Cons (x, q) = l in
		branch
			let True = eq x v in
			True
		or
			let False = eq x v in
			mem v q
		end
	end

term correct_set: (l:line) → boolean =
	branch
		let Nil = l in True
	or
		let Cons (x, q) = l in
		branch
			let True = eq Z x in
			correct_set q
		or
			let False = eq Z x in
			branch
				let False = mem x q in
				correct_set q
			or
				let True = mem x q in
				False
			end
		end
	end

term forall: (l:list<boolean>) → boolean =
(** Checks whether all elements of the list are booleans *)
	branch
		let Nil = l in True
	or
		let Cons (True, q) = l in forall q
	or
		let Cons (False, q) = l in False
	end

term range_aux: (n:nat) → (accu:list<nat>) → list<nat> =
(** returns [range n + accu] *)
	branch
		let Z = n in accu
	or
		let S m = n in
		let accu' = Cons<nat> (m, accu) in
		range_aux m accu'
	end

term range: (n:nat) → list<nat> =
	(** [range n] is the list [[0, ..., n-1]] *)
	range_aux n Nil<nat>

term correct_line: (g:grid) → (n:nat) → boolean =
(** Checks whether the n-th line is correct.
    Lines are numeroted from 0 to size² - 1 *)
		let (size, g) = g in
		let line = list_nth<list<nat>> n g in
		correct_set line

term correct_square: (g:grid) → (x:nat) → (y:nat) → boolean =
(** Checks whether the square at position (x, y) is correct.
    Positions are numeroted from 0 to size - 1 *)
	let (size, g) = g in
	let x = mul x size in
	let y = mul y size in
	let lines = sublist<list<nat>> y size g in
	let square = list_map<line,line>(λ l : line → sublist<nat> x size l) lines in
	let values = list_flatten<nat> square in
	correct_set values

term correct_column: (g:grid) → (n:nat) → boolean =
(** Checks whether the n-th column is correct.
    Columns are numeroted from 0 to size² - 1 *)
	let (size, g) = g in
	let col = list_map<line,nat> (λ l: line → list_nth<nat> n l) g in
	correct_set col

term correct_grid: (g: grid) → boolean =
	let (n, g') = g in
	let range_n = range n in
	let n2 = mul n n in
	let range_n2 = range n2 in
	let columns = list_map<nat,boolean> (λ n:nat → correct_column g n) range_n2 in
	let lines = list_map<nat,boolean> (λ n:nat → correct_line g n) range_n2 in
	let squares = list_map<nat,list<boolean>> (λ h:nat →
		list_map<nat, boolean> (λ w:nat → correct_square g h w) range_n) range_n in
	let squares_flat = list_flatten<boolean> squares in
	let c = forall columns in
	let l = forall lines in
	let s = forall squares_flat in
	forall (Cons<boolean> (c, Cons<boolean> (l, Cons<boolean> (s, Nil<boolean>))))

term solved_line: (l:line) → boolean =
	let l' = list_map<nat,boolean> (λ x:nat → neq Z x) l in
	forall l'

term solved: (g:grid) → boolean =
	let (size, g) = g in
	let g' = list_map<line,boolean> (λ l:line → solved_line l) g in
	forall g'

term pick<a>: (l:list<a>) → a =
	(** Pick an element of list l *)
	branch
		let Cons (x, q) = l in x
	or
		let Cons (x, q) = l in pick<a> q
	end

term pick_nat: (n:nat) → nat =
	(** pick a nat < n *)
	let range_n = range n in
	pick<nat> range_n

term insert: (m:nat) → (n:nat) → (v: nat) → (g:list<list<nat>>)
		→ (nat, list<list<nat>>) =
	let l = list_nth<list<nat>> m g in
	let (w, new_l) = list_switch<nat> n v l in
	let (_, new_g) = list_switch<list<nat>> m new_l g in
	(w, new_g)

term get_first_zero_aux: (grid:grid) → (m:nat) → (n:nat) → (nat, nat) =
	let (size, g) = grid in
	let size2 = mul size size in
	branch
		let True = eq m size2 in (size2, size2)
	or
		let False = eq m size2 in
		branch
			let True = eq n size2 in
			get_first_zero_aux grid (S m) Z
		or
			let False = eq n size2 in
			let line = list_nth<list<nat>> m g in
			branch
				let Z = list_nth<nat> n line in
				(m, n)
			or
				let S _ = list_nth<nat> n line in
				get_first_zero_aux grid m (S n)
			end
		end
	end

term get_first_zero: (g:grid) → (nat, nat) =
	get_first_zero_aux g Z Z

term fill: (g:grid) → grid =
	let (size, g) = g in
	let size2 = mul size size in
	let (m, n) = get_first_zero (size, g) in
	let v = pick_nat size2 in
	let (Z, g') = insert m n (S v) g in
	let True = correct_grid (size, g') in
	(size,g')

term solve: (g: grid) → grid =
	branch
		let True = solved g in
		g
	or
		let g' = fill g in
		solve g'
	end


term empty: (n:nat) → grid =
	let n2=mul n n in
	let range_n2 = range n2 in
	let empty_line = list_map<nat,nat> (λ x : nat → Z) range_n2 in
	let array = list_map<nat, line> (λ x: nat → empty_line) range_n2 in
	(n, array)

